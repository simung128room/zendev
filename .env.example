# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional alternative AI gateways (for fallback/multi-provider routing)
XKIRO_API_KEY=""
UNOROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://dev-api.apexcheck.space"

# CORS and Security Configuration
NODE_ENV="production"
ALLOWED_ORIGINS="https://apexcheck.space,https://localhost,http://localhost:3000"
TRUST_PROXY_HOPS="1"

# Frontend API URL (leave empty if unified domain, or set for separate backend/APK build)
VITE_API_BASE_URL=""

# Supabase (Optional: for Auth and Blog CMS database)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
